# Trikon LLM configuration -- copy to `.env` and fill in.
#
# The entire deterministic pipeline runs WITHOUT any of these set. If no key is
# present, Trikon runs in deterministic-only mode: ambiguous candidates are escalated
# to the human review queue instead of being adjudicated, and every metric is still
# computed. This is intentional -- a reviewer with no API key must be able to
# reproduce all reported numbers.
#
# Verify with:  trikon doctor

# --- Provider (OpenAI-compatible chat completions) ---------------------------------
# AgentRouter:  https://agentrouter.org/v1        (keys look like ak-...)
# OpenRouter:   https://openrouter.ai/api/v1      (keys look like sk-or-v1-...)
TRIKON_LLM_BASE_URL=https://agentrouter.org/v1
TRIKON_LLM_API_KEY=
TRIKON_LLM_MODEL=glm-5.2

# Optional comma-separated fallback models, tried in order if the primary errors.
# Keep these cheap; the adjudicator only ever sees pre-computed evidence packets.
TRIKON_LLM_FALLBACK_MODELS=

# --- Budget guards ------------------------------------------------------------------
# Free tiers are tight (OpenRouter free is 20 req/min and 50 req/day unless you have
# ever purchased >= $10 of credits, which raises the daily cap to 1000). Trikon
# refuses to exceed these rather than failing halfway through a batch.
TRIKON_LLM_MAX_CALLS_PER_RUN=25
TRIKON_LLM_REQUESTS_PER_MINUTE=15
TRIKON_LLM_TIMEOUT_SECONDS=90

# How many ambiguous cases to pack into a single adjudication call. Batching is what
# keeps LLM cost proportional to ambiguity rather than to batch size.
TRIKON_LLM_ADJUDICATION_BATCH_SIZE=5

# --- Cache --------------------------------------------------------------------------
# Every response is cached on disk keyed by a hash of the evidence packet. Cached runs
# are free, reproducible, and work offline -- which is how the demo stays reliable.
TRIKON_LLM_CACHE_DIR=data/cache
TRIKON_LLM_CACHE_ENABLED=true
